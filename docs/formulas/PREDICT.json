{
 "sheet": "PREDICT",
 "header_row": 2,
 "data_row": 3,
 "columns": {
  "A": {
   "header": "HELP CODE",
   "formula": "=MODEL[[#This Row],[Code]]"
  },
  "B": {
   "header": "HARD CODE",
   "formula": "141746"
  },
  "C": {
   "header": "Player Name",
   "formula": "=INDEX(MODEL[FPL_Name],MATCH(PREDICT[[#This Row],[HARD CODE]],MODEL[Code],0))"
  },
  "D": {
   "header": "IF START PTS",
   "formula": "=SUMIFS(PPts[IF START TOTAL],PPts[Code],PREDICT[[#This Row],[HARD CODE]],PPts[GW], \">=\"&$BB$2,PPts[GW], \"<=\"&$BC$2)"
  },
  "E": {
   "header": "TRUE PTS",
   "formula": "=SUMIFS(PPts[TRUE TOTAL],PPts[Code],PREDICT[[#This Row],[HARD CODE]],PPts[GW], \">=\"&$BB$2,PPts[GW], \"<=\"&$BC$2)"
  },
  "F": {
   "header": "Start %",
   "formula": "=INDEX(PPts!$BH$2:$BH$1000,MATCH(PREDICT[[#This Row],[HARD CODE]],PPts!$E$2:$E$1000,0))"
  },
  "G": {
   "header": "\u2691",
   "formula": "=IF(INDEX(MODEL[Chance of Playing],MATCH(PREDICT[[#This Row],[HARD CODE]],MODEL[Code],0))*100=100,\"\",INDEX(MODEL[Chance of Playing],MATCH(PREDICT[[#This Row],[HARD CODE]],MODEL[Code],0))*100)"
  },
  "H": {
   "header": "Manual Start %",
   "formula": null
  },
  "I": {
   "header": "M/S",
   "formula": "=INDEX(MODEL[G+A PSxTS Mn/Start],MATCH(PREDICT[[#This Row],[HARD CODE]],MODEL[Code],0))*90"
  },
  "J": {
   "header": "Fix",
   "formula": "=SUMIFS(PPts[1-60 mins],PPts[Code],PREDICT[[#This Row],[HARD CODE]],PPts[GW], \">=\"&$BB$2,PPts[GW], \"<=\"&$BC$2)"
  },
  "K": {
   "header": "POS",
   "formula": "=INDEX(MODEL[POS],MATCH(PREDICT[[#This Row],[HARD CODE]],MODEL[Code],0))"
  },
  "L": {
   "header": "TEAM",
   "formula": "=INDEX(MODEL[TEAM],MATCH(PREDICT[[#This Row],[HARD CODE]],MODEL[Code],0))"
  },
  "M": {
   "header": "\u00a3",
   "formula": "=IFERROR(INDEX(API[now_cost],MATCH(PREDICT[[#This Row],[HARD CODE]],API[code],0))/10,0)"
  },
  "N": {
   "header": "VALUE",
   "formula": "=IFERROR((PREDICT[[#This Row],[TRUE PTS]]/PREDICT[[#This Row],[\u00a3]])/PREDICT[[#This Row],[Fix]],0)"
  },
  "O": {
   "header": "%",
   "formula": "=IFERROR(INDEX(API[selected_by_percent],MATCH(PREDICT[[#This Row],[HARD CODE]],API[code],0)),0)"
  },
  "P": {
   "header": "P",
   "formula": "=IFERROR(INDEX(PSAPI[total_points],MATCH(PREDICT[[#This Row],[HARD CODE]],PSAPI[code],0)),0)"
  },
  "Q": {
   "header": "DC",
   "formula": "=INDEX(MODEL[11],MATCH(PREDICT[[#This Row],[HARD CODE]],MODEL[Code],0))/2"
  },
  "R": {
   "header": "BP",
   "formula": "=INDEX(MODEL[6],MATCH(PREDICT[[#This Row],[HARD CODE]],MODEL[Code],0))"
  },
  "S": {
   "header": "YC",
   "formula": "=ABS(INDEX(MODEL[4],MATCH(PREDICT[[#This Row],[HARD CODE]],MODEL[Code],0)))"
  },
  "T": {
   "header": "G",
   "formula": "=IFERROR(INDEX(PSAPI[goals_scored],MATCH(PREDICT[[#This Row],[HARD CODE]],PSAPI[code],0)),0)"
  },
  "U": {
