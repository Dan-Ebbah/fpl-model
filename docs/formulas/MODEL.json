{
 "sheet": "MODEL",
 "header_row": 1,
 "data_row": 2,
 "columns": {
  "A": {
   "header": "Code",
   "formula": "=API!$E2"
  },
  "B": {
   "header": "FPL_Name",
   "formula": "=IFERROR(INDEX(API[first_name],MATCH(MODEL[[#This Row],[Code]],API[code],0))&\" \"&INDEX(API[second_name],MATCH(MODEL[[#This Row],[Code]],API[code],0)),\"-\")"
  },
  "C": {
   "header": "web_name",
   "formula": "=IFERROR(INDEX(API[web_name],MATCH(MODEL[[#This Row],[Code]],API[code],0)),\"-\")"
  },
  "D": {
   "header": "FBRef_Name",
   "formula": "David Raya"
  },
  "E": {
   "header": "Alt Name 2",
   "formula": "-"
  },
  "F": {
   "header": "POS",
   "formula": "=IFERROR(INDEX(element_type[],MATCH(INDEX(API[],MATCH(MODEL[[#This Row],[Code]],API[code],0),MATCH(\"element_type\",API[#Headers],0)),element_type[element_type],0),MATCH(\"POS\",element_type[#Headers],0)),\"-\")"
  },
  "G": {
   "header": "POS2",
   "formula": "GK"
  },
  "H": {
   "header": "TEAM",
   "formula": "=IFERROR(INDEX(TEAMS[short_name],MATCH(INDEX(API[team],MATCH(MODEL[[#This Row],[Code]],API[code],0)),TEAMS[id],0)),\"-\")"
  },
  "I": {
   "header": "Full Team",
   "formula": "=IFERROR(INDEX(TEAMS[name],MATCH(INDEX(API[team],MATCH(MODEL[[#This Row],[Code]],API[code],0)),TEAMS[id],0)),\"-\")"
  },
  "J": {
   "header": "PS Starts",
   "formula": "=MODEL[[#This Row],[Previous Season Starts1]]"
  },
  "K": {
   "header": "PS Subs",
   "formula": "=MODEL[[#This Row],[Previous Season Subs1]]"
  },
  "L": {
   "header": "PS UnSub",
   "formula": "=MODEL[[#This Row],[Previous Season UnSub1]]"
  },
  "M": {
   "header": "PS Mn/St",
   "formula": "=MODEL[[#This Row],[Previous Season Mn/Start]]"
  },
  "N": {
   "header": "PS Mn/Sub",
   "formula": "=MODEL[[#This Row],[Previous Season Mn/Sub]]"
  },
  "O": {
   "header": "PS Mn/St %",
   "formula": "=IF(MODEL[[#This Row],[POS]]=\"GK\",1,IF(MODEL[[#This Row],[PS Starts]]=0,0.66,MODEL[[#This Row],[PS Mn/St]]/90))"
  },
  "P": {
   "header": "PS Mn/Sub %",
   "formula": "=IF(MODEL[[#This Row],[PS Mn/Sub]]=0,0.2,MODEL[[#This Row],[PS Mn/Sub]]/90)"
  },
  "Q": {
   "header": "PS Sts/SqdsMd",
   "formula": "=IFERROR(MODEL[[#This Row],[PS Starts]]/(MODEL[[#This Row],[PS Starts]]+MODEL[[#This Row],[PS Subs]]+MODEL[[#This Row],[PS UnSub]]),0)"
  },
  "R": {
   "header": "PS UnSub/SqdsMd",
   "formula": "=IFERROR(MODEL[[#This Row],[PS UnSub]]/(MODEL[[#This Row],[PS Starts]]+MODEL[[#This Row],[PS Subs]]+MODEL[[#This Row],[PS UnSub]]),0)"
  },
  "S": {
   "header": "PS Mins",
   "formula": "=IFERROR(INDEX(PSAPI[minutes],MATCH(MODEL[[#This Row],[Code]],PSAPI[code],0)),0)"
  },
  "T": {
   "header": "PS Saves",
   "formula": "=IFERROR(INDEX(PSAPI[saves],MATCH(MODEL[[#This Row],[Code]],PSAPI[code],0)),0)"
  },
  "U": {
   "header": "PS Saves/90",
   "formula": "=IFERROR((MODEL[[#This Row],[PS Saves]]/MODEL[[#This Row],[PS Mins]])*90,0)"
  },
  "V": {
   "header": "PS YCs",
   "formula": "=IFERROR(INDEX(PSAPI[yellow_cards],MATCH(MODEL[[#This Row],[Code]],PSAPI[code],0)),0)"
  },
  "W": {
   "header": "PS YC/St",
   "formula": "=IFERROR((MODEL[[#This Row],[PS YCs]]/MODEL[[#This Row],[PS Mins]])*90*MODEL[[#This Row],[PS Mn/St %]],0)"
  },
  "X": {
   "header": "PS RCs",
   "formula": "=IFERROR(INDEX(PSAPI[red_cards],MATCH(MODEL[[#This Row],[Code]],PSAPI[code],0)),0)"
  },
  "Y": {
   "header": "PS RC/90",
   "formula": "=IFERROR((MODEL[[#This Row],[PS RCs]]/MODEL[[#This Row],[PS Mins]])*90,0)"
  },
  "Z": {
   "header": "PS Bonus",
   "formula": "=IFERROR(INDEX(PSAPI[bonus],MATCH(MODEL[[#This Row],[Code]],PSAPI[code],0)),0)"
  },
  "AA": {
   "header": "PS BPS",
   "formula": "=IFERROR(INDEX(PSAPI[bps],MATCH(MODEL[[#This Row],[Code]],PSAPI[code],0)),0)"
  },
  "AB": {
   "header": "PS Start BPS",
   "formula": "=IFERROR(MODEL[[#This Row],[PS BPS]]*((MODEL[[#This Row],[PS Starts]]*MODEL[[#This Row],[PS Mn/St]])/MODEL[[#This Row],[PS Mins]]),0)"
  },
  "AC": {
   "header": "PS BPS/Start",
   "formula": "=IFERROR(IF(MODEL[[#This Row],[PS Start BPS]]/MODEL[[#This Row],[PS Starts]]=0,CONTROL!$B$43,MODEL[[#This Row],[PS Start BPS]]/MODEL[[#This Row],[PS Starts]]),CONTROL!$B$43)"
  },
  "AD": {
   "header": "PS Bonus/Start",
   "formula": "=IFERROR(IF(MODEL[[#This Row],[PS Bonus]]/MODEL[[#This Row],[PS Starts]]=0,CONTROL!$B$44,MODEL[[#This Row],[PS Bonus]]/MODEL[[#This Row],[PS Starts]]),CONTROL!$B$44)"
  },
  "AE": {
   "header": "PS A",
   "formula": "=IFERROR(INDEX(PSAPI[assists],MATCH(MODEL[[#This Row],[Code]],PSAPI[code],0)),0)"
  },
  "AF": {
   "header": "PS A/St",
   "formula": "=IFERROR((MODEL[[#This Row],[PS A]]/MODEL[[#This Row],[PS Mins]])*90*MODEL[[#This Row],[PS Mn/St %]],0)"
  },
  "AG": {
   "header": "PS xA",
   "formula": "=IFERROR(INDEX(PSAPI[expected_assists],MATCH(MODEL[[#This Row],[Code]],PSAPI[code],0)),0)"
  },
  "AH": {
   "header": "PS xA/St",
   "formula": "=IFERROR((MODEL[[#This Row],[PS xA]]/MODEL[[#This Row],[PS Mins]])*90*MODEL[[#This Row],[PS Mn/St %]],0)"
  },
  "AI": {
   "header": "PS DC Hits",
   "formula": "0"
  },
  "AJ": {
   "header": "PS DC Hits/Starts",
   "formula": "=IFERROR(MODEL[[#This Row],[PS DC Hits]]/MODEL[[#This Row],[PS Starts]],0)"
  },
  "AK": {
   "header": "G+A PSxTS Mn/Start",
   "formula": "=(MODEL[[#This Row],[PS Mn/St %]]*CONTROL!$B$62)+(CONTROL!$B$63*MODEL[[#This Row],[Mn/St %]])"
  },
  "AL": {
   "header": "G+A PSxTS Mn/Sub",
   "formula": "=(MODEL[[#This Row],[PS Mn/Sub %]]*CONTROL!$B$62)+(CONTROL!$B$63*MODEL[[#This Row],[Mn/Sub %]])"
  },
  "AM": {
   "header": "Chance of Playing",
   "formula": "=IFERROR(IF(INDEX(API[chance_of_playing_next_round],MATCH(API[[#This Row],[code]],API[code],0))=\"\",1,(INDEX(API[chance_of_playing_next_round],MATCH(API[[#This Row],[code]],API[code],0)))/100),0)"
  },
  "AN": {
   "header": "Starts",
   "formula": "=MODEL[[#This Row],[Starts1]]"
  },
  "AO": {
   "header": "Subs",
   "formula": "=MODEL[[#This Row],[Subs1]]"
  },
  "AP": {
   "header": "UnSub",
   "formula": "=MODEL[[#This Row],[UnSub1]]"
  },
  "AQ": {
   "header": "Mn/St",
   "formula": "=MODEL[[#This Row],[Mn/Start1]]"
  },
  "AR": {
   "header": "Mn/Sub",
   "formula": "=MODEL[[#This Row],[Mn/Sub1]]"
  },
  "AS": {
   "header": "Mn/St %",
   "formula": "=IF(MODEL[[#This Row],[POS]]=\"GK\",1,IF(MODEL[[#This Row],[Starts]]=0,0.66,MODEL[[#This Row],[Mn/St]]/90))"
  },
  "AT": {
   "header": "Mn/Sub %",
   "formula": "=IF(MODEL[[#This Row],[Mn/Sub]]=0,0.2,MODEL[[#This Row],[Mn/Sub]]/90)"
  },
  "AU": {
   "header": "St/SqdsMd",
   "formula": "=IFERROR(MODEL[[#This Row],[Starts]]/(MODEL[[#This Row],[Starts]]+MODEL[[#This Row],[Subs]]+MODEL[[#This Row],[UnSub]]),0)"
  },
  "AV": {
   "header": "UnSub/SqdsMd",
   "formula": "=IFERROR(MODEL[[#This Row],[UnSub]]/(MODEL[[#This Row],[Starts]]+MODEL[[#This Row],[Subs]]+MODEL[[#This Row],[UnSub]]),0)"
  },
  "AW": {
   "header": "Mins",
   "formula": "=IFERROR(INDEX(API[minutes],MATCH(MODEL[[#This Row],[Code]],API[code],0)),0)"
  },
  "AX": {
   "header": "Saves",
   "formula": "=IFERROR(INDEX(API[saves],MATCH(MODEL[[#This Row],[Code]],API[code],0)),0)"
  },
  "AY": {
   "header": "Saves/90",
   "formula": "=IFERROR((MODEL[[#This Row],[Saves]]/MODEL[[#This Row],[Mins]])*90,0)"
  },
  "AZ": {
   "header": "YCs",
   "formula": "=IFERROR(INDEX(API[yellow_cards],MATCH(MODEL[[#This Row],[Code]],API[code],0)),0)"
  },
  "BA": {
   "header": "YC/90",
   "formula": "=IFERROR((MODEL[[#This Row],[YCs]]/MODEL[[#This Row],[Mins]])*90,0)"
  },
  "BB": {
   "header": "RCs",
   "formula": "=IFERROR(INDEX(API[red_cards],MATCH(MODEL[[#This Row],[Code]],API[code],0)),0)"
  },
  "BC": {
   "header": "RC/90",
   "formula": "=IFERROR((MODEL[[#This Row],[RCs]]/MODEL[[#This Row],[Mins]])*90,0)"
  },
  "BD": {
   "header": "Bonus",
   "formula": "=IFERROR(INDEX(API[bonus],MATCH(MODEL[[#This Row],[Code]],API[code],0)),0)"
  },
  "BE": {
   "header": "BPS",
   "formula": "=IFERROR(INDEX(API[bps],MATCH(MODEL[[#This Row],[Code]],API[code],0)),0)"
  },
  "BF": {
   "header": "Start BPS",
   "formula": "=IFERROR(MODEL[[#This Row],[BPS]]*((MODEL[[#This Row],[Starts]]*MODEL[[#This Row],[Mn/St]])/MODEL[[#This Row],[Mins]]),0)"
  },
  "BG": {
   "header": "BPS/Start",
   "formula": "=IFERROR(MODEL[[#This Row],[Start BPS]]/MODEL[[#This Row],[Starts]],CONTROL!$B$43)"
  },
  "BH": {
   "header": "Bonus/Start",
   "formula": "=IFERROR(MODEL[[#This Row],[Bonus]]/MODEL[[#This Row],[Starts]],CONTROL!$B$44)"
  },
  "BI": {
   "header": "A",
   "formula": "=IFERROR(INDEX(API[assists],MATCH(MODEL[[#This Row],[Code]],API[code],0)),0)"
  },
  "BJ": {
   "header": "A/St",
   "formula": "=IFERROR((MODEL[[#This Row],[A]]/MODEL[[#This Row],[Mins]])*90*MODEL[[#This Row],[Mn/St %]],0)"
  },
  "BK": {
   "header": "xA",
   "formula": "=IFERROR(INDEX(API[expected_assists],MATCH(MODEL[[#This Row],[Code]],API[code],0)),0)"
  },
  "BL": {
   "header": "xA/St",
   "formula": "=IFERROR((MODEL[[#This Row],[xA]]/MODEL[[#This Row],[Mins]])*90*MODEL[[#This Row],[Mn/St %]],0)"
  },
  "BM": {
   "header": "LF G+A Mins",
   "formula": "=IFERROR(SUM(INDEX(MINS!$B$1001:$CZ$1999,MODEL[[#This Row],[PT CODE ROW MATCH]],CONTROL!$E$2-CONTROL!$D$56+1-CONTROL!$C$56):INDEX(MINS!$B$1001:$CZ$1999,MODEL[[#This Row],[PT CODE ROW MATCH]],CONTROL!$E$2-CONTROL!$E$56)),0)"
  },
  "BN": {
   "header": "LF xA",
   "formula": "=IFERROR(SUM(INDEX(xA!$B$1001:$CZ$1999,MODEL[[#This Row],[PT CODE ROW MATCH]],CONTROL!$E$2-CONTROL!$D$56+1-CONTROL!$C$56):INDEX(xA!$B$1001:$CZ$1999,MODEL[[#This Row],[PT CODE ROW MATCH]],CONTROL!$E$2-CONTROL!$E$56)),0)"
  },
  "BO": {
   "header": "LF xA/St",
   "formula": "=IFERROR((MODEL[[#This Row],[LF xA]]/MODEL[[#This Row],[LF G+A Mins]])*90*((MODEL[[#This Row],[PS Mn/St %]]*CONTROL!$B$62)+(CONTROL!$B$63*MODEL[[#This Row],[Mn/St %]])),0)"
  },
  "BP": {
   "header": "LF xG",
   "formula": "=IFERROR(SUM(INDEX(xG!$B$1001:$CZ$1999,MODEL[[#This Row],[PT CODE ROW MATCH]],CONTROL!$E$2-CONTROL!$D$56+1-CONTROL!$C$56):INDEX(xG!$B$1001:$CZ$1999,MODEL[[#This Row],[PT CODE ROW MATCH]],CONTROL!$E$2-CONTROL!$E$56)),0)"
  },
  "BQ": {
   "header": "LF xG/St",
   "formula": "=IFERROR((MODEL[[#This Row],[LF xG]]/MODEL[[#This Row],[LF G+A Mins]])*90*((MODEL[[#This Row],[PS Mn/St %]]*CONTROL!$B$62)+(CONTROL!$B$63*MODEL[[#This Row],[Mn/St %]])),0)"
  },
  "BR": {
   "header": "LF Pl",
   "formula": "=IFERROR(SUM(INDEX(PL!$B$1001:$CZ$1999,MODEL[[#This Row],[PT CODE ROW MATCH]],CONTROL!$E$2-CONTROL!$D$56+1-CONTROL!$C$56):INDEX(PL!$B$1001:$CZ$1999,MODEL[[#This Row],[PT CODE ROW MATCH]],CONTROL!$E$2-CONTROL!$E$56)),0)"
  },
  "BS": {
   "header": "PT CODE ROW MATCH",
   "formula": "=MATCH(MODEL[[#This Row],[Code]],MINS!$A$1001:$A$1999,0)"
  },
  "BT": {
   "header": "LF xGC",
   "formula": "=IFERROR(SUM(INDEX(xGC!$B$1001:$CZ$1999,MATCH(MODEL[[#This Row],[TEAM]],xGC!$A$1001:$A$1999,0),CONTROL!$E$2-CONTROL!$D$69+1-CONTROL!$C$69):INDEX(xGC!$B$1001:$CZ$1999,MATCH(MODEL[[#This Row],[TEAM]],xGC!$A$1001:$A$1999,0),CONTROL!$E$2-CONTROL!$E$69)),0)"
  },
  "BU": {
   "header": "LF xGC Pl",
   "formula": "=IFERROR(SUM(INDEX(PL!$B$2200:$CZ$2290,MATCH(MODEL[[#This Row],[TEAM]],PL!$A$2200:$A$2290,0),CONTROL!$E$2-CONTROL!$D$69+1-CONTROL!$C$69):INDEX(PL!$B$2200:$CZ$2290,MATCH(MODEL[[#This Row],[TEAM]],PL!$A$2200:$A$2290,0),CONTROL!$E$2-CONTROL!$E$69)),0)"
  },
  "BV": {
   "header": "LF xGC/90",
   "formula": "=IFERROR(INDEX(TABLES[LF US xGC FIX],MATCH(MODEL[[#This Row],[TEAM]],TABLES[ABVR],0)),0)"
  },
  "BW": {
   "header": "LF % CS/St",
   "formula": "=EXP(-MODEL[[#This Row],[LF xGC/90]]*((MODEL[[#This Row],[PS Mn/St %]]*CONTROL!$B$62)+(CONTROL!$B$63*MODEL[[#This Row],[Mn/St %]])))*MODEL[[#This Row],[2]]"
  },
  "BX": {
   "header": "LF % 2+ GC",
   "formula": "=1-(MODEL[[#This Row],[LF % CS/St]]*(1+MODEL[[#This Row],[LF xGC/90]]))"
  },
  "BY": {
   "header": "LF DCs",
   "formula": "=IFERROR(SUM(INDEX(DC!$B$1001:$CZ$1999,MODEL[[#This Row],[PT CODE ROW MATCH]],CONTROL!$E$2-CONTROL!$D$83+1-CONTROL!$C$83):INDEX(DC!$B$1001:$CZ$1999,MODEL[[#This Row],[PT CODE ROW MATCH]],CONTROL!$E$2-CONTROL!$E$83)),0)"
  },
  "BZ": {
   "header": "LF DC Mins",
   "formula": "=IFERROR(SUM(INDEX(MINS!$B$1001:$CZ$1999,MODEL[[#This Row],[PT CODE ROW MATCH]],CONTROL!$E$2-CONTROL!$D$83+1-CONTROL!$C$83):INDEX(MINS!$B$1001:$CZ$1999,MODEL[[#This Row],[PT CODE ROW MATCH]],CONTROL!$E$2-CONTROL!$E$83)),0)"
  },
  "CA": {
   "header": "LF DC/St",
   "formula": "=IFERROR((MODEL[[#This Row],[LF DCs]]/MODEL[[#This Row],[LF DC Mins]])*90*((MODEL[[#This Row],[PS Mn/St %]]*CONTROL!$B$89)+(CONTROL!$B$90*MODEL[[#This Row],[Mn/St %]])),0)"
  },
  "CB": {
   "header": "LF DC %",
   "formula": "=1-_xlfn.POISSON.DIST(IF(MODEL[[#This Row],[POS]]=\"DEF\",9,11),MODEL[[#This Row],[LF DC/St]],TRUE)"
  },
  "CC": {
   "header": "SF Mins",
   "formula": "=IFERROR(SUM(INDEX(MINS!$B$1001:$CZ$1999,MODEL[[#This Row],[PT CODE ROW MATCH]],CONTROL!$E$2-CONTROL!$D$57+1-CONTROL!$C$57):INDEX(MINS!$B$1001:$CZ$1999,MODEL[[#This Row],[PT CODE ROW MATCH]],CONTROL!$E$2-CONTROL!$E$57)),0)"
  },
  "CD": {
   "header": "SF xA",
   "formula": "=IFERROR(SUM(INDEX(xA!$B$1001:$CZ$1999,MODEL[[#This Row],[PT CODE ROW MATCH]],CONTROL!$E$2-CONTROL!$D$57+1-CONTROL!$C$57):INDEX(xA!$B$1001:$CZ$1999,MODEL[[#This Row],[PT CODE ROW MATCH]],CONTROL!$E$2-CONTROL!$E$57)),0)"
  },
  "CE": {
   "header": "SF xA/St",
   "formula": "=IFERROR((MODEL[[#This Row],[SF xA]]/MODEL[[#This Row],[SF Mins]])*90*((MODEL[[#This Row],[PS Mn/St %]]*CONTROL!$B$62)+(CONTROL!$B$63*MODEL[[#This Row],[Mn/St %]])),0)"
  },
  "CF": {
   "header": "SF xG",
   "formula": "=IFERROR(SUM(INDEX(xG!$B$1001:$CZ$1999,MODEL[[#This Row],[PT CODE ROW MATCH]],CONTROL!$E$2-CONTROL!$D$57+1-CONTROL!$C$57):INDEX(xG!$B$1001:$CZ$1999,MODEL[[#This Row],[PT CODE ROW MATCH]],CONTROL!$E$2-CONTROL!$E$57)),0)"
  },
  "CG": {
   "header": "SF xG/St",
   "formula": "=IFERROR((MODEL[[#This Row],[SF xG]]/MODEL[[#This Row],[SF Mins]])*90*((MODEL[[#This Row],[PS Mn/St %]]*CONTROL!$B$62)+(CONTROL!$B$63*MODEL[[#This Row],[Mn/St %]])),0)"
  },
  "CH": {
   "header": "SF Pl",
   "formula": "=IFERROR(SUM(INDEX(PL!$B$1001:$CZ$1999,MODEL[[#This Row],[PT CODE ROW MATCH]],CONTROL!$E$2-CONTROL!$D$57+1-CONTROL!$C$57):INDEX(PL!$B$1001:$CZ$1999,MODEL[[#This Row],[PT CODE ROW MATCH]],CONTROL!$E$2-CONTROL!$E$57)),0)"
  },
  "CI": {
   "header": "SF xGC",
   "formula": "=IFERROR(SUM(INDEX(xGC!$B$1001:$CZ$1999,MATCH(MODEL[[#This Row],[TEAM]],xGC!$A$1001:$A$1999,0),CONTROL!$E$2-CONTROL!$D$70+1-CONTROL!$C$70):INDEX(xGC!$B$1001:$CZ$1999,MATCH(MODEL[[#This Row],[TEAM]],xGC!$A$1001:$A$1999,0),CONTROL!$E$2-CONTROL!$E$70)),0)"
  },
  "CJ": {
   "header": "SF xGC Pl",
   "formula": "=IFERROR(SUM(INDEX(PL!$B$2200:$CZ$2290,MATCH(MODEL[[#This Row],[TEAM]],PL!$A$2200:$A$2290,0),CONTROL!$E$2-CONTROL!$D$70+1-CONTROL!$C$70):INDEX(PL!$B$2200:$CZ$2290,MATCH(MODEL[[#This Row],[TEAM]],PL!$A$2200:$A$2290,0),CONTROL!$E$2-CONTROL!$E$70)),0)"
  },
  "CK": {
   "header": "SF xGC/90",
   "formula": "=IFERROR(INDEX(TABLES[SF US xGC FIX],MATCH(MODEL[[#This Row],[TEAM]],TABLES[ABVR],0)),0)"
  },
  "CL": {
   "header": "SF % CS/90",
   "formula": "=EXP(-MODEL[[#This Row],[SF xGC/90]]*((MODEL[[#This Row],[PS Mn/St %]]*CONTROL!$B$62)+(CONTROL!$B$63*MODEL[[#This Row],[Mn/St %]])))*MODEL[[#This Row],[2]]"
  },
  "CM": {
   "header": "SF % 2+ GC",
   "formula": "=1-(MODEL[[#This Row],[SF % CS/90]]*(1+MODEL[[#This Row],[SF xGC/90]]))"
  },
  "CN": {
   "header": "SF DCs",
   "formula": "=IFERROR(SUM(INDEX(DC!$B$1001:$CZ$1999,MODEL[[#This Row],[PT CODE ROW MATCH]],CONTROL!$E$2-CONTROL!$D$84+1-CONTROL!$C$84):INDEX(DC!$B$1001:$CZ$1999,MODEL[[#This Row],[PT CODE ROW MATCH]],CONTROL!$E$2-CONTROL!$E$84)),0)"
  },
  "CO": {
   "header": "SF DC Mins",
   "formula": "=IFERROR(SUM(INDEX(MINS!$B$1001:$CZ$1999,MODEL[[#This Row],[PT CODE ROW MATCH]],CONTROL!$E$2-CONTROL!$D$84+1-CONTROL!$C$84):INDEX(MINS!$B$1001:$CZ$1999,MODEL[[#This Row],[PT CODE ROW MATCH]],CONTROL!$E$2-CONTROL!$E$84)),0)"
  },
  "CP": {
   "header": "SF DC/St",
   "formula": "=IFERROR((MODEL[[#This Row],[SF DCs]]/MODEL[[#This Row],[SF DC Mins]])*90*((MODEL[[#This Row],[PS Mn/St %]]*CONTROL!$B$89)+(CONTROL!$B$90*MODEL[[#This Row],[Mn/St %]])),0)"
  },
  "CQ": {
   "header": "SF DC %",
   "formula": "=1-_xlfn.POISSON.DIST(IF(MODEL[[#This Row],[POS]]=\"DEF\",9,11),MODEL[[#This Row],[SF DC/St]],TRUE)"
  },
  "CR": {
   "header": "1-60 mins",
   "formula": "1"
  },
  "CS": {
   "header": "PS %1",
   "formula": "=IF(AND(MODEL[[#This Row],[PS Starts]]=0,MODEL[[#This Row],[PS Subs]]=0),0.01,(1-MODEL[[#This Row],[PS UnSub/SqdsMd]])*0.99)"
  },
  "CT": {
   "header": "%1",
   "formula": "=IF(AND(MODEL[[#This Row],[Starts]]=0,MODEL[[#This Row],[Subs]]=0),0.01,(1-MODEL[[#This Row],[UnSub/SqdsMd]])*0.99)"
  },
  "CU": {
   "header": "1",
   "formula": "=IFERROR(((MODEL[[#This Row],[PS %1]]*CONTROL!$B$8)+(MODEL[[#This Row],[%1]]*CONTROL!$B$9))*MODEL[[#This Row],[1-60 mins]]*MODEL[[#This Row],[Chance of Playing]],0)"
  },
  "CV": {
   "header": "60+ mins",
   "formula": "1"
  },
  "CW": {
   "header": "PS %2",
